# systemd unit for the Liar's Dice server.
# Install to /etc/systemd/system/liars-dice.service on your LXC/VM, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now liars-dice
#   systemctl status liars-dice
#   journalctl -u liars-dice -f
#
# Assumes the repo lives at /opt/liars_dice and runs as the `liarsdice` user.

[Unit]
Description=Liar's Dice (online multiplayer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=liarsdice
Group=liarsdice
WorkingDirectory=/opt/liars_dice
ExecStart=/usr/bin/node server.js
Environment=NODE_ENV=production
Environment=PORT=3000
Restart=always
RestartSec=3

# --- light hardening (the app writes nothing to disk) ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
