{
  "name": "liars-dice-online",
  "version": "1.0.0",
  "description": "Online multiplayer Liar's Dice for 2-11 players (no wilds, with spot-on call).",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
