    "dev": "node --watch server.js",
    "test": "node --test",
    "gen-tts": "node scripts/gen-tts.mjs"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "overrides": {
    "ws": ">=8.20.2"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
